          listeners [
            beforeload function (_self, options) {
                  options.params =     options.params || {};
                  options.params.person_id = _this.form.findField('id').getValue() * 1;
            }
          ]
          remoteSort = true;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v ? v.format('d/M/Y') : ''); 
          };
          dataIndex = "event_when";
          header = "Event when";
          width = 75;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "action";
          header = "Action";
          width = 100;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "remarks";
          header = "Remarks";
          width = 200;
        }
        listeners [
          celldblclick function (_self, rowIndex, columnIndex, e) {
                r = _self.ds.getAt(rowIndex);
                if(r.data.id) {
                    window.open(baseURL + '/Admin/EventView/' + r.data.id + '.html');
                }
                
          },
          render function() {
                _this.actionGrid = this; 
                //_this.dialog = Pman.Dialog.FILL_IN
                if (_this.actionPanel.active) {
                   _this.actionGrid.ds.load({});
                }
          }
        ]
        loadMask = true;
      }
      listeners [
        activate function() {
              _this.actionPanel = this;
              if (_this.actionGrid) {
                  _this.actionGrid.ds.load({});
              }
        }
      ]
      region = "center";
      tableName = "Events";
      title = "Action";
