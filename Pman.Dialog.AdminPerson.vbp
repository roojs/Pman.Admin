vbp-version = 1;
name = Pman.Dialog.AdminPerson;
modOrder = 001;

Roo.LayoutDialog {
  Boolean modal = true;
  closable = false;
  collapsible = false;
  height = 400;
  center = Roo.layout.Region {
    String tabPosition = "top";
  }
  [
    Roo.panel.Content {
      String title = "Staff Details";
      [
        Roo.form.Form {
          url = baseURL + '/Roo/core_person';
          Number labelWidth = 120;
          [
            Roo.form.TextField {
              allowBlank = true;
              fieldLabel = "Name";
              name = "name";
              width = 250;
            },
            Roo.form.TextField {
              allowBlank = false;
              fieldLabel = "Email";
              name = "email";
              width = 250;
            },
            Roo.form.TextField {
              fieldLabel = "Role / Position";
              name = "role";
              width = 250;
            },
            Roo.form.TextField {
              fieldLabel = "Phone";
              name = "phone";
              width = 150;
            },
            Roo.form.Hidden {
              name = "company_id";
            },
            Roo.form.ComboBox {
              allowBlank = true;
              displayField = "name";
              editable = false;
              emptyText = "Department / Office";
              fieldLabel = "Department / Office";
              forceSelection = true;
              hiddenName = "office_id";
              store = Roo.data.Store {
                sortInfo = @{ direction : 'ASC', field: 'id' };
                proxy = Roo.data.HttpProxy {
                  url = baseURL + '/Roo/core_office';
                  method = "GET";
                }
                reader = Roo.data.JsonReader {
                  fields = @[{"name":"id","type":"int"},{"name":"name","type":"string"}];
                  id = "id";
                  root = "data";
                  totalProperty = "total";
                }
                listeners [
                  beforeload function (_self, o) {
                        o.params = o.params || {};
                        var coid = _this.form.findField('company_id').getValue();
                        o.params.company_id = coid;
                  }
                ]
                remoteSort = true;
              }
              listWidth = 400;
              listeners [
                beforequery function (combo, query, forceAll, cancel, e) {
                          var coid = _this.form.findField('company_id').getValue();
                          if (coid < 1 ) {
                              Roo.MessageBox.alert("Error", "Select An Company First");
                              return false;
                          }
                }
              ]
              loadingText = "Searching...";
              minChars = 2;
              name = "office_id_name";
              pageSize = 20;
              qtip = "Select Office";
              queryParam = "query[name]";
              selectOnFocus = true;
              tpl = '<div class="x-grid-cell-text x-btn button"><b>{name}</b> </div>';
              triggerAction = "all";
              typeAhead = true;
              valueField = "id";
              width = 250;
            },
            Roo.form.Checkbox {
              Boolean checked = true;
              String fieldLabel = "Active";
              String inputValue = 1;
              String name = "active";
              String valueOff = 0;
            },
            Roo.form.Hidden {
              name = "id";
            },
            Roo.form.Hidden {
              name = "group_ids";
            },
            Roo.form.FieldSet {
              Number labelWidth = 200;
              String legend = "Change / Set Password";
              String|Object|Function style = "width:370px";
              [
                Roo.Button {
                  String text = "Generate password";
                  listeners [
                    click function (_self, e) {
                          var chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz~!@-#$';
                          var pwd = Array.from(crypto.getRandomValues(new Uint32Array(16)))
                              .map(x => chars[x % chars.length])
                              .join('');
                          _this.form.findField('passwd1').setValue(pwd);
                          _this.form.findField('passwd2').setValue(pwd);
                          if (_this.form.findField('passwd1').el.attr('type') == 'password') {
                              _this.form.findField('passwd1').onToggleClick();
                          }
                          if (_this.form.findField('passwd2').el.attr('type') == 'password') {
                              _this.form.findField('passwd2').onToggleClick();
                          }
                    }
                  ]
                  style = "margin-left:205px;margin-bottom:8px;";
                },
                Roo.form.Password {
                  fieldLabel = "New password";
                  name = "passwd1";
                  width = 150;
                },
                Roo.form.Password {
                  allowBlank = true;
                  fieldLabel = "Password (type again to confirm)";
                  name = "passwd2";
                  width = 150;
                },
                Roo.form.Checkbox {
                  Boolean checked = true;
                  String fieldLabel = "Secure passwords";
                  String inputValue = 1;
                  String name = "secure_password";
                  String valueOff = 0;
                  listeners [
                    check function (_self, checked) {
                          this.form.findField('passwd1').insecure = false;
                              
                          if(!checked){
                              this.form.findField('passwd1').insecure = true;
                          }
                    }
                  ]
                }
              ]
            }
          ]
          listeners [
            actioncomplete function(_self,action) {
                  if (action.type == 'setdata') {
                      var reg = _this.dialog.layout.getRegion('center');
                      if (_this.data.id * 1 > 0) {
                          for (var i = 5; i >= 0; i--) {
                              reg.showPanel(i);
                          }
                          _this.saveBtn.setText('Save');
                          this.load({ method: 'GET', params: { '_id' : _this.data.id, '_with_group_ids' : 1 }});
                          return;
                      }
                      for (var i = 5; i > 0; i--) {
                          reg.hidePanel(i);
                      }
                      reg.showPanel(0);
                      _this.saveBtn.setText('Next');
                      this.findField('company_id').setValue(Pman.Login.authUser.company_id);
                      return;
                  }
                  if (action.type == 'load') {
                      _this.dialog.el.unmask();
                      _this.dialog.layout.getRegion('center').showPanel(0);
                      _this.groupGrid.dataSource.load();
                      return;
                  }
                  if (action.type =='submit') {
                      _this.dialog.el.unmask();
                      if (_this.form.findField('id').getValue() * 1 < 1) {
                          _this.form.findField('id').setValue(action.result.data.id);
                          _this.data = action.result.data;
                          for (var i = 5; i >= 0; i--) {
                              _this.dialog.layout.getRegion('center').showPanel(i);
                          }
                          _this.saveBtn.setText('Save');
                          _this.groupGrid.dataSource.load();
                          return;
                      }
                      _this.dialog.hide();
                      if (_this.callback) {
                          _this.callback.call(_this, _this.form.getValues());
                      }
                      _this.form.reset();
                      return;
                  }
            },
            rendered function (form) {
                  _this.form= form;
            }
          ]
          method = "POST";
          style = "margin:10px;";
        }
      ]
      region = "center";
    },
    Roo.panel.Grid {
      background = true;
      fitContainer = true;
      fitToframe = true;
      grid = Roo.grid.Grid {
        autoExpandColumn = "data";
        dataSource = Roo.data.Store {
          sortInfo = @{ field : 'name', direction: 'ASC' };
          proxy = Roo.data.HttpProxy {
            url = baseURL + '/Roo/core_person_settings';
            method = "GET";
          }
          reader = Roo.data.JsonReader {
            id = "id";
            root = "data";
            totalProperty = "total";
          }
          listeners [
            beforeload function (_self, o) {
                
                  o.params = o.params ? o.params : {};
                  o.params.person_id =  _this.form.findField('id').getValue();
                  
                 
            }
          ]
          remoteSort = true;
        }
        footer = Roo.PagingToolbar {
          displayInfo = true;
          displayMsg = "Displaying Settings  {0} - {1} of {2}";
          emptyMsg = "No Settings Found";
          pageSize = 25;
        }
        toolbar = Roo.Toolbar {
          [
            Roo.Toolbar.Fill {},
            Roo.Toolbar.Button {
              icon = rootURL + '/Pman/templates/images/trash.gif';
              cls = "x-btn-text-icon";
              listeners [
                click function() {
                       Pman.genericDelete(_this, 'core_person_settings'); 
                }
              ]
              text = "Delete";
            }
          ]
        }
        colModel[] = Roo.grid.ColumnModel {
          dataIndex = "scope";
          header = "Module";
          sortable = true;
          width = 120;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "description";
          header = "Description";
          sortable = true;
          width = 150;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "data";
          header = "Value";
          sortable = true;
          width = 200;
        }
        sm = Roo.grid.RowSelectionModel {
          listeners [
            afterselectionchange function (_self) {
                  // load project members.
            }
          ]
          singleSelect = true;
        }
        listeners [
          render function() {
                _this.grid = this; 
                //_this.dialog = Pman.Dialog.FILL_IN
                if (_this.panel.active) {
                   this.footer.onClick('first');
                }
          },
          rowdblclick function (_self, rowIndex, e) {
                if (!_this.dialog) {
                     return;
                 }
                _this.dialog.show( this.getDataSource().getAt(rowIndex).data, function() {
                    _this.grid.footer.onClick('refresh');
                }); 
          }
        ]
        loadMask = true;
      }
      listeners [
        activate function() {
              _this.panel = this;
           
              if (_this.grid) {
                  _this.grid.footer.onClick('first');
              }
        }
      ]
      region = "center";
      title = "System Settings";
    },
    Roo.panel.Grid {
      Boolean fitToFrame = true;
      background = true;
      fitContainer = true;
      grid = Roo.grid.Grid {
        autoExpandColumn = "user_agent";
        dataSource = Roo.data.Store {
          sortInfo = @{ field : 'last_access_dt', direction: 'DESC' };
          proxy = Roo.data.HttpProxy {
            url = baseURL + '/Roo/core_person_window';
            method = "GET";
          }
          reader = Roo.data.JsonReader {
            id = "id";
            root = "data";
            totalProperty = "total";
          }
          listeners [
            beforeload function (_self, o) {
                
                  o.params = o.params ? o.params : {};
                  o.params.person_id =  _this.form.findField('id').getValue();
                  
                 
            }
          ]
          remoteSort = true;
        }
        footer = Roo.PagingToolbar {
          displayInfo = true;
          displayMsg = "Displaying Sessions  {0} - {1} of {2}";
          emptyMsg = "No Settings Found";
          pageSize = 25;
        }
        toolbar = Roo.Toolbar {
          [
            Roo.Toolbar.Fill {},
            Roo.Toolbar.Button {
              icon = rootURL + '/Pman/templates/images/trash.gif';
              cls = "x-btn-text-icon";
              listeners [
                click function() {
                        new Pman.Request({
                          method : 'POST',
                          url : baseURL + '/Roo/Core_person_window',
                          params : {
                              status : 'KILL',
                              person_id : _this.data.id
                          },
                          success : function()
                          {
                              _this.sesgrid.footer.onClick('refresh');
                          }
                      });
                }
              ]
              text = "Force Logout of User";
            }
          ]
        }
        colModel[] = Roo.grid.ColumnModel {
          dataIndex = "app_id";
          header = "Application";
          sortable = true;
          width = 120;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "ip";
          header = "IP Address";
          sortable = true;
          width = 80;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             
                return String.format('{0}', v ? v.format("d/M H:i")  : ''); 
          };
          dataIndex = "login_dt";
          header = "Logged in";
          sortable = true;
          width = 80;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             
                return String.format('{0}', v ? v.format("d/M H:i")  : ''); 
          };
          dataIndex = "last_access_dt";
          header = "Last Access";
          sortable = true;
          width = 80;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "status";
          header = "Status";
          sortable = true;
          width = 40;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "window_id";
          header = "Session WID";
          sortable = true;
          width = 80;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "user_agent";
          header = "Browser";
          sortable = true;
          width = 150;
        }
        listeners [
          render function() {
                _this.sesgrid = this; 
                //_this.dialog = Pman.Dialog.FILL_IN
                if (_this.sespanel.active) {
                   this.footer.onClick('first');
                }
          }
        ]
        loadMask = true;
      }
      listeners [
        activate function() {
              _this.sespanel = this;
           
             
           if (_this.sesgrid) {
                  _this.sesgrid.footer.onClick('first');
              }
        }
      ]
      region = "center";
      title = "User Sessions";
    }
  ]
  buttons[] = Roo.Button {
    listeners [
      click function (_self, e) {
            _this.dialog.hide();
      }
    ]
    text = "Cancel";
  }
  buttons[] = Roo.Button {
    listeners [
      render function (_self) {
            _this.saveBtn = _self;
      },
      click function (_self, e) {
            var p1 = _this.form.findField('passwd1').getValue();
            var p2 = _this.form.findField('passwd2').getValue();
            if (_this.sendAfterSave && !p1.length) {
                Roo.MessageBox.alert("Error", "You must create a password to send introduction mail");
                return;
            }
            if (Pman.Login.authUser.id < 0 && !p1.length) {
                Roo.MessageBox.alert("Error", "You must create a password for the admin account");
                return;
            }
            if ((p1.length || p2.length) && p1 != p2) {
                Roo.MessageBox.alert("Error", "Passwords do not match");
                return;
            }
            if (_this.groupGrid) {
                var ids = [];
                _this.groupGrid.dataSource.each(function(r) {
                    if (r.data.is_in_group * 1) {
                        ids.push(r.data.id);
                    }
                });
                _this.form.findField('group_ids').setValue(ids.join(','));
            }
            _this.form.doAction("submit");
        
      }
    ]
    text = "Save";
  }
  [
    Roo.GridPanel {
      background = false;
      fitContainer = true;
      fitToframe = true;
      grid = Roo.grid.Grid {
        autoExpandColumn = "name";
        toolbar = Roo.Toolbar {
          [
            Roo.form.TextField {
              listeners [
                keyup function (_self, e) {
                      _this.groupGrid.view.refresh(true);
                },
                render function (_self) {
                    _this.groupFilter = _self;
                }
              ]
              width = 100;
            },
            Roo.Toolbar.Button {
              icon = rootURL + '/Pman/templates/images/edit-clear.gif';
              cls = "x-btn-icon";
              listeners [
                click function (_self, e) {
                      _this.groupFilter.setValue('');
                      _this.groupGrid.view.refresh(true);
                }
              ]
            },
            Roo.Toolbar.Fill {}
          ]
        }
        dataSource = Roo.data.Store {
          sortInfo = @{ field : 'name', direction: 'ASC' };
          proxy = Roo.data.HttpProxy {
            url = baseURL + '/Roo/core_group.php';
            method = "GET";
          }
          reader = Roo.data.JsonReader {
            fields = [

];
            id = "id";
            root = "data";
            totalProperty = "total";
          }
          listeners [
            beforeload function (_self, options) {
                  options.params = options.params || {};
                  options.params.limit = 999;
                  options.params._is_in_group = _this.form.findField('id').getValue();
            },
            load function (_self, records, options) {
                  var groupIds = _this.form.findField('group_ids').getValue();
                  if (!groupIds.length) {
                      return;
                  }
                  var selected = groupIds.split(',');
                  Roo.each(records, function(r) {
                      if (selected.indexOf('' + r.data.id) > -1) {
                          r.set('is_in_group', 1);
                      }
                  });
            }
          ]
          remoteSort = true;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
              
                var state = v> 0 ?  '-checked' : '';
            
                return '<img class="x-grid-check-icon' + state + '" src="' + Roo.BLANK_IMAGE_URL + '"/>';
                            
             
          };
          dataIndex = "is_in_group";
          header = "Select";
          width = 75;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v,x,r) {
             return String.format('{0}', v ? v : ''); 
          };
          dataIndex = "name";
          header = "Group";
        }
        listeners [
          cellclick function (_self, ri, ci , e) {
                if (ci != 0) {return; }
                
                var rec = this.ds.getAt(ri);
                rec.set('is_in_group', (rec.get('is_in_group') * 1) ? 0 : 1);
                rec.commit();
                var ids = [];
                _this.groupGrid.dataSource.each(function(r) {
                    if (r.data.is_in_group * 1) {
                        ids.push(r.data.id);
                    }
                });
                _this.form.findField('group_ids').setValue(ids.join(','));
          },
          rowclass function (gridview, rowcfg) {
                rowcfg.rowClass = '';
                
                var filter = _this.groupFilter.getValue().toLowerCase();
                
                if(!filter.length) {
                    return; // display
                }
                
                if(rowcfg.record.data.name.toLowerCase().match(new RegExp(filter))) {
                    return; // display
                }
                
                rowcfg.rowClass = 'display-none';
          },
          render function() {
                _this.groupGrid = this;
          }
        ]
        loadMask = true;
      }
      listeners [
        render function (_self) {
              _this.gruopPanel = this;
        }
      ]
      region = "center";
      tableName = "core_group";
      title = "Groups";
    },
    Roo.GridPanel {
      background = true;
      fitContainer = true;
      fitToframe = true;
      grid = Roo.grid.Grid {
        autoExpandColumn = "remarks";
        dataSource = Roo.data.Store {
          sortInfo = @{ field : 'id', direction: 'DESC' };
          proxy = Roo.data.HttpProxy {
            url = baseURL + '/Roo/Events.php';
            method = "GET";
          }
          reader = Roo.data.JsonReader {
            fields = @[
    {
        'name': 'id',
        'type': 'int'
    },
    {
        'name': 'person_name',
        'type': 'string'
    },
    {
        'name': 'event_when',
        'type': 'date',
        'dateFormat': 'Y-m-d'
    },
    {
        'name': 'action',
        'type': 'string'
    },
    {
        'name': 'ipaddr',
        'type': 'string'
    },
    {
        'name': 'on_id',
        'type': 'int'
    },
    {
        'name': 'on_table',
        'type': 'string'
    },
    {
        'name': 'person_id',
        'type': 'int'
    },
    {
        'name': 'remarks',
        'type': 'string'
    },
    {
        'name': 'person_id_id',
        'type': 'int'
    },
    {
        'name': 'person_id_office_id',
        'type': 'int'
    },
    {
        'name': 'person_id_name',
        'type': 'string'
    },
    {
        'name': 'person_id_phone',
        'type': 'string'
    },
    {
        'name': 'person_id_fax',
        'type': 'string'
    },
    {
        'name': 'person_id_email',
        'type': 'string'
    },
    {
        'name': 'person_id_company_id',
        'type': 'int'
    },
    {
        'name': 'person_id_role',
        'type': 'string'
    },
    {
        'name': 'person_id_active',
        'type': 'int'
    },
    {
        'name': 'person_id_remarks',
        'type': 'string'
    },
    {
        'name': 'person_id_passwd',
        'type': 'string'
    },
    {
        'name': 'person_id_owner_id',
        'type': 'int'
    },
    {
        'name': 'person_id_lang',
        'type': 'string'
    },
    {
        'name': 'person_id_no_reset_sent',
        'type': 'int'
    },
    {
        'name': 'person_id_action_type',
        'type': 'string'
    },
    {
        'name': 'person_id_project_id',
        'type': 'int'
    },
    {
        'name': 'person_id_deleted_by',
        'type': 'int'
    },
    {
        'name': 'person_id_deleted_dt',
        'type': 'date'
    }
];
            id = "id";
            root = "data";
            totalProperty = "total";
          }
          listeners [
            beforeload function (_self, options) {
                  options.params =     options.params || {};
                  options.params.on_table = 'core_person';
                  options.params.on_id = _this.form.findField('id').getValue() * 1;
                  if (!options.params.on_id) {
                      return false;
                  }
                      
            }
          ]
          remoteSort = true;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v ? v.format('d/M/Y') : ''); 
          };
          dataIndex = "event_when";
          header = "Event when";
          width = 75;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "person_id_name";
          header = "Who";
          width = 200;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "action";
          header = "Action";
          width = 100;
        }
        colModel[] = Roo.grid.ColumnModel {
          renderer = function(v) {
             return String.format('{0}', v); 
          };
          dataIndex = "remarks";
          header = "Remarks";
          width = 200;
        }
        listeners [
          celldblclick function (_self, rowIndex, columnIndex, e) {
                r = _self.ds.getAt(rowIndex);
                if(r.data.id) {
                    window.open(baseURL + '/Admin/EventView/' + r.data.id + '.html');
                }
                
          },
          render function() {
                _this.logGrid = this; 
                //_this.dialog = Pman.Dialog.FILL_IN
                if (_this.logPanel.active) {
                   _this.logGrid.ds.load({});
                }
          }
        ]
        loadMask = true;
      }
      listeners [
        activate function() {
              _this.logPanel = this;
              if (_this.logGrid) {
                  _this.logGrid.ds.load({});
              }
        }
      ]
      region = "center";
      tableName = "Events";
      title = "Log";
    },
    Roo.GridPanel {
      background = true;
      fitContainer = true;
      fitToframe = true;
      grid = Roo.grid.Grid {
        autoExpandColumn = "remarks";
        dataSource = Roo.data.Store {
          sortInfo = @{ field : 'id', direction: 'DESC' };
          proxy = Roo.data.HttpProxy {
            url = baseURL + '/Roo/Events.php';
            method = "GET";
          }
          reader = Roo.data.JsonReader {
            fields = @[
    {
        'name': 'id',
        'type': 'int'
    },
    {
        'name': 'person_name',
        'type': 'string'
    },
    {
        'name': 'event_when',
        'type': 'date',
